# systemd creates the socket with the right owner and mode, so the service needs no chown.
# systemctl enable --now gh-cred-proxy@app.socket
[Unit]
Description=gh-cred-proxy socket (%i)

[Socket]
ListenStream=/run/gh-cred-proxy/%i.sock
SocketUser=gh-cred-proxy
SocketGroup=gh-cred-proxy-clients
SocketMode=0660
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
