# User unit for the git forwarder: systemctl --user enable --now gh-cred-proxy-forward
[Unit]
Description=gh-cred-proxy loopback forwarder for git

[Service]
ExecStart=/opt/gh-cred-proxy/.venv/bin/gh-cred-proxy forward --socket /run/gh-cred-proxy/app.sock
Restart=on-failure
UMask=0077

[Install]
WantedBy=default.target
