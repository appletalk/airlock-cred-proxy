# One instance per identity, started by airlock-cred-proxy@<name>.socket.
# Config: /etc/airlock-cred-proxy/%i.toml (root:airlock-cred-proxy 0640)
# Key:    /etc/airlock-cred-proxy/%i.key  (root:root 0600, read by systemd, handed over via LoadCredential)
[Unit]
Description=airlock-cred-proxy (%i)
Requires=airlock-cred-proxy@%i.socket
After=airlock-cred-proxy@%i.socket network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airlock-cred-proxy
Group=airlock-cred-proxy
ExecStart=/opt/airlock-cred-proxy/.venv/bin/airlock-cred-proxy serve --config /etc/airlock-cred-proxy/%i.toml
LoadCredential=app-key:/etc/airlock-cred-proxy/%i.key
LogsDirectory=airlock-cred-proxy
LogsDirectoryMode=0750
UMask=0077
Restart=on-failure
MemoryMax=512M
# One thread per connection (MAX_CONNECTIONS=64) plus headroom.
TasksMax=160

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
